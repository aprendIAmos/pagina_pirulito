# Puerto del server. Render lo inyecta solo; en local usá 3000.
PORT=3000

# Origenes permitidos por CORS, separados por coma.
# Incluye http://localhost:3000 para desarrollo.
CORS_ORIGIN=http://localhost:3000

# Secreto para firmar el JWT de sesión. Cambialo en producción.
JWT_SECRET=cambiame-por-algo-largo-y-aleatorio

# "mock" usa los datos en memoria de server/mock/.
# "supabase" usará la base real (todavía no implementado).
DATA_PROVIDER=mock
